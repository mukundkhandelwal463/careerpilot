# ==============================================================================
# CareerPilot Kubernetes Secret Template (DevSecOps compliant)
# Copy this file to secret.yaml and base64-encode your credentials:
#   echo -n "your-secret" | base64
# ==============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: careerpilot-secrets
  namespace: careerpilot
  labels:
    app.kubernetes.io/name: careerpilot
type: Opaque
data:
  # Base64 encoded values (default placeholders provided below)
  # Replace with: echo -n 'YOUR_SECRET' | base64
  DJANGO_SECRET_KEY: Y2FyZWVycGlsb3QtcHJvZC1zZWNyZXQta2V5LTIwMjY= # "careerpilot-prod-secret-key-2026"
  GEMINI_API_KEY: "" # Base64 encoded Gemini API key
  POSTGRES_USER: Y2FyZWVycGlsb3Q= # "careerpilot"
  POSTGRES_PASSWORD: Y2FyZWVycGlsb3Rfc2VjcmV0 # "careerpilot_secret"
  SMTP_SERVER: c210cC5nbWFpbC5jb20= # "smtp.gmail.com"
  SMTP_PORT: NTg3 # "587"
  SMTP_USER: "" # Base64 encoded SMTP username
  SMTP_PASS: "" # Base64 encoded SMTP password
  MAIL_SENDER: "" # Base64 encoded Mail sender
