# ==============================================================================
# CareerPilot Frontend - Multi-Stage Production Dockerfile (Node 20 + Nginx Alpine)
# Reference: CareerPilot Project Synopsis Section 7 (Containerization)
# ==============================================================================

# Stage 1: Build stage compiles the React 19 / Vite 7 production bundle
FROM node:20-alpine AS builder

WORKDIR /app

# Copy dependency definitions and install packages
COPY client/package*.json ./
RUN npm ci || npm install

# Copy frontend source code and build the production bundle
COPY client/ ./
RUN npm run build

# ==============================================================================
# Stage 2: Minimal Nginx runtime stage to serve static assets & proxy APIs
# ==============================================================================
FROM nginx:alpine-slim AS runner

# Remove default Nginx welcome page
RUN rm -rf /usr/share/nginx/html/*

# Copy compiled production assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy custom Nginx configuration
COPY docker/nginx-frontend.conf /etc/nginx/conf.d/default.conf

# Expose HTTP port
EXPOSE 80

# Health check to ensure Nginx is serving the frontend
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost/ || exit 1

# Start Nginx in foreground
CMD ["nginx", "-g", "daemon off;"]
