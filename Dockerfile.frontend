
# Stage 1: Build stage compiles the React 19 / Vite 7 production bundle
FROM node:20-alpine AS builder

WORKDIR /app

# Copy dependency definitions and install packages
COPY client/package*.json ./
RUN npm ci || npm install

# Copy frontend source code and build the production bundle
COPY client/ ./
RUN npm run build

FROM nginx:alpine-slim AS runner

RUN rm -rf /usr/share/nginx/html/*

COPY --from=builder /app/dist /usr/sha
COPY docker/nginx-frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
